meta {
  name: Client login
  type: http
  seq: 2
}

post {
  url: {{middlewareUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{clientEmail}}",
    "password": "{{clientPassword}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("accessToken", res.body.accessToken);
    bru.setEnvVar("clientId", res.body.user.clientId);
  }
}
